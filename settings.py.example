# SQLite database path
DB_PATH = 'data/evetrader.db'

# Static data
REGIONS_DF = 'https://www.fuzzwork.co.uk/dump/latest/csv/mapRegions.csv'
TYPES_DF = 'https://www.fuzzwork.co.uk/dump/latest/csv/invTypes.csv'
MARKET_GROUPS_DF = 'https://www.fuzzwork.co.uk/dump/latest/csv/invMarketGroups.csv'
STATIONS_DF = 'https://www.fuzzwork.co.uk/dump/latest/csv/staStations.csv'
SOLAR_SYSTEMS_DF = 'https://www.fuzzwork.co.uk/dump/latest/csv/mapSolarSystems.csv'
SOLAR_SYSTEM_JUMPS_DF = 'https://www.fuzzwork.co.uk/dump/latest/csv/mapSolarSystemJumps.csv'
NPC_CORPORATIONS_DF = 'https://www.fuzzwork.co.uk/dump/latest/csv/crpNPCCorporations.csv'
FACTIONS_DF = 'https://www.fuzzwork.co.uk/dump/latest/csv/chrFactions.csv'

# Path to EVE Online market logs directory
# Example for Windows: r'C:\Users\YourName\Documents\EVE\logs\Marketlogs'
# Example for Linux: '/home/username/.eve/logs/Marketlogs'
MARKETLOGS_DIR = r'C:\Users\YourName\Documents\EVE\logs\Marketlogs'

# Trade Opportunities Settings
MIN_SELL_PRICE = 500_000
MAX_BUY_PRICE = 100_000_000
MIN_PROFIT_PERCENT = 20
MIN_DAILY_QUANTITY = 200

# EVE Online App
EVE_CLIENT_ID = 'app_client_id'
EVE_CLIENT_SECRET = 'app_client_secret'
EVE_CALLBACK_URL = 'http://localhost:8888/callback'
EVE_SCOPES = "esi-markets.read_character_orders.v1 esi-wallet.read_character_wallet.v1 esi-location.read_location.v1 esi-ui.write_waypoint.v1 esi-ui.open_window.v1 esi-characters.read_standings.v1 esi-skills.read_skills.v1"
EVE_CALLBACK_HOST = 'localhost'
EVE_CALLBACK_PORT = '8888'
